# Copy to .env and edit. .env is git-ignored. Never commit real keys.
# Docker Compose reads .env automatically; export the same variables in the shell that runs
# `python -m repo_reviewer` (bash: `set -a; source .env; set +a`).

# Shared secret between the CLI and the LiteLLM Proxy. Generate your own, e.g.:
#   python -c "import secrets; print('sk-' + secrets.token_hex(24))"
LITELLM_MASTER_KEY=

# Only needed for --mode deepseek. Source code excerpts are sent to DeepSeek in that mode.
DEEPSEEK_API_KEY=

# Where the proxy container finds Ollama (Ollama runs on the host). Default shown.
# OLLAMA_API_BASE=http://host.docker.internal:11434

# --- CLI client settings (all optional) ---
# REVIEWER_GATEWAY_URL=http://127.0.0.1:4000/v1
# REVIEWER_MODEL=reviewer-local        # override the alias chosen by --mode
# REVIEWER_TIMEOUT_S=120
# REVIEWER_MAX_RETRIES=1
# REVIEWER_MAX_TOKENS=1024
# REVIEWER_TEMPERATURE=0

# --- EXPERIMENTAL decision-model routing (--router decision --decision-backend systemone) ---
# DECISION_API_BASE=http://127.0.0.1:4000
# DECISION_MODEL=router-decision
# DECISION_TIMEOUT_S=15
# Refused unless set to 1 AND the base URL is not local: request text would leave your machine.
# DECISION_ALLOW_REMOTE=0
